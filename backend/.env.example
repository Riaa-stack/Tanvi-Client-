# ─────────────────────────────────────────────────────────────────────────────
# EduArchive AI 2.0 — Environment Configuration
# Copy this file to .env and fill in all values before starting the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
FLASK_ENV=development
# development | production | testing
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-long-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://eduarchive:eduarchive_password@localhost:5432/eduarchive_db

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
# Temperature: 0.0 = deterministic, 1.0 = creative
GEMINI_TEMPERATURE=0.1
# Timeout in seconds for a single Gemini API call
GEMINI_TIMEOUT=120
# Maximum number of retries for failed Gemini calls
GEMINI_MAX_RETRIES=3

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Absolute or relative path for ChromaDB persistent storage
CHROMA_PERSIST_DIRECTORY=./storage/chroma

# ── File Storage ──────────────────────────────────────────────────────────────
# Directory for uploaded PDFs (papers and notes)
UPLOAD_DIRECTORY=./storage/uploads
# Maximum file size in bytes (default 50 MB)
MAX_UPLOAD_SIZE=52428800

# ── OCR ───────────────────────────────────────────────────────────────────────
# Set to false to disable OCR entirely (faster but won't handle scanned PDFs)
OCR_ENABLED=true
# Path to tesseract executable (leave blank to use system default)
TESSERACT_CMD=
# Minimum text density ratio below which OCR is triggered (0.0–1.0)
OCR_TEXT_DENSITY_THRESHOLD=0.05

# ── Embeddings ────────────────────────────────────────────────────────────────
# Sentence-transformers model name
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Batch size for embedding generation
EMBEDDING_BATCH_SIZE=32

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ── Processing ────────────────────────────────────────────────────────────────
# Overall processing timeout in seconds
PAPER_PROCESSING_TIMEOUT=600
# Minimum similarity threshold for semantic repetition detection (0.0–1.0)
REPETITION_SIMILARITY_THRESHOLD=0.82

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# ── API ───────────────────────────────────────────────────────────────────────
# Maximum page size for paginated list endpoints
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
